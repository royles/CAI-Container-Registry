# Persist registry blobs under the CAI project filesystem (NFS-backed in production).
REGISTRY_DATA_DIR=data/registry
IMPORT_JOBS_DIR=data/import_jobs

# Optional HTTP Basic auth for /v2/ and read APIs (recommended in shared projects).
LOCAL_REGISTRY_USERNAME=registry
LOCAL_REGISTRY_PASSWORD=change-me

# Protect import/management routes (required for mutating operations when set).
APP_API_KEY=change-me-import-key

# Metadata: hostname users configure for docker pull via the CAI application URL.
PUBLIC_REGISTRY_HOST=registry-app.example.cloudera.com

# Remote registry TLS (set false only for local dev against insecure registries).
REGISTRY_VERIFY_TLS=true
# REGISTRY_CA_BUNDLE=/path/to/ca.pem
